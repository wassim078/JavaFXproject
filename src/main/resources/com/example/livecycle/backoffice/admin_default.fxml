<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.chart.BarChart?>
<ScrollPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.livecycle.controllers.backoffice.AdminDefault"
            stylesheets="@../css/dashboard_default.css"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            prefViewportWidth="1200"
            prefViewportHeight="800">

    <VBox spacing="25" style="-fx-padding: 25;" maxWidth="1200">
        <!-- User Management Section -->
        <VBox styleClass="module-container" spacing="15">
            <Label text="User Management Statistics" styleClass="module-title"/>

            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 0 0 15 0;">
                <ComboBox fx:id="periodSelector" prefWidth="200" styleClass="chart-control"/>
            </HBox>

            <HBox spacing="30" alignment="CENTER_LEFT">
                <LineChart fx:id="registrationChart" title="Registration Trend"
                           styleClass="animated-chart" prefWidth="800" prefHeight="400"
                           maxWidth="1100" HBox.hgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Period" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Registrations" />
                    </yAxis>
                </LineChart>

                <PieChart fx:id="roleChart" title="Role Distribution"
                          styleClass="role-chart" prefWidth="350" prefHeight="400"
                          maxWidth="400" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- Commandes Section -->
        <VBox styleClass="module-container" spacing="15">
            <Label text="Commandes Management Statistics" styleClass="module-title"/>

            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 0 0 15 0;">
                <ComboBox fx:id="commandesPeriodSelector" prefWidth="200" styleClass="chart-control"/>
            </HBox>

            <LineChart fx:id="commandesChart" title="Commandes Trend"
                       styleClass="animated-chart" prefWidth="1100" prefHeight="400"
                       maxWidth="1200" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis label="Period" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Number of Commandes" />
                </yAxis>
            </LineChart>
            <ComboBox fx:id="frequencyPeriodSelector" prefWidth="200" styleClass="chart-control"/>
            <HBox spacing="20" alignment="CENTER" VBox.vgrow="ALWAYS">

                <BarChart fx:id="leastOrderedChart" title="Least Frequent Orders"
                          styleClass="frequency-chart" legendVisible="false"
                          prefWidth="500" prefHeight="400" HBox.hgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Product ID" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Number of Orders" />
                    </yAxis>
                </BarChart>

                <PieChart fx:id="paymentMethodChart" title="Payment Methods Distribution"
                          styleClass="payment-chart" prefWidth="400" prefHeight="400"
                          maxWidth="400" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- Annonces Section -->
        <VBox styleClass="module-container" spacing="15">
            <Label text="Annonces Management Statistics" styleClass="module-title"/>
            
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 0 0 15 0;">
                <ComboBox fx:id="annoncesPeriodSelector" prefWidth="200" styleClass="chart-control"/>
            </HBox>

            <HBox spacing="30" alignment="CENTER">
                <!-- Stats Cards -->
                <VBox spacing="15" styleClass="stats-cards-container">
                    <HBox spacing="20">
                        <VBox styleClass="stat-card">
                            <Label fx:id="totalAnnoncesLabel" styleClass="stat-number"/>
                            <Label text="Total Annonces" styleClass="stat-title"/>
                        </VBox>
                        
                        <VBox styleClass="stat-card">
                            <Label fx:id="activeAnnoncesLabel" styleClass="stat-number"/>
                            <Label text="Active Annonces" styleClass="stat-title"/>
                        </VBox>
                    </HBox>
                    
                    <HBox spacing="20">
                        <VBox styleClass="stat-card">
                            <Label fx:id="avgPriceLabel" styleClass="stat-number"/>
                            <Label text="Average Price" styleClass="stat-title"/>
                        </VBox>
                        
                        <VBox styleClass="stat-card">
                            <Label fx:id="totalCategoriesLabel" styleClass="stat-number"/>
                            <Label text="Categories" styleClass="stat-title"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Category Distribution Chart -->
                <PieChart fx:id="categoryDistributionChart" 
                         title="Annonces by Category"
                         styleClass="category-chart" 
                         prefWidth="400" 
                         prefHeight="300"/>
            </HBox>

            <!-- Annonces Trend Chart -->
            <LineChart fx:id="annoncesTrendChart" 
                      title="Annonces Creation Trend"
                      styleClass="animated-chart" 
                      prefHeight="300">
                <xAxis>
                    <CategoryAxis label="Period"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Number of Annonces"/>
                </yAxis>
            </LineChart>
        </VBox>
        <!-- Reclamations Section -->
        <VBox styleClass="module-container" spacing="15">
            <Label text="Reclamation Management Statistics" styleClass="module-title"/>

            <!-- Period Selector -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label  styleClass="chart-label"/>
                <ComboBox fx:id="reclamationPeriodSelector" styleClass="chart-control"/>
            </HBox>

            <!-- Bar Chart -->
            <BarChart fx:id="reclamationChart" styleClass="reclamation-chart" title="Reclamation Statistics">
                <xAxis>
                    <CategoryAxis label="Period" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Number of Reclamations" />
                </yAxis>
            </BarChart>
        </VBox>

        <!-- Collect Section -->
        <VBox styleClass="module-container" spacing="15">
            <Label text="Collect Management Statistics" styleClass="module-title"/>

            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 0 0 15 0;">
                <ComboBox fx:id="collectPeriodSelector" prefWidth="200" styleClass="chart-control"/>
            </HBox>

            <LineChart fx:id="collectChart" title="Collects Over Time"
                       styleClass="animated-chart" prefWidth="1100" prefHeight="400"
                       maxWidth="1200" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis label="Period" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Number of Collects" />
                </yAxis>
            </LineChart>

            <BarChart fx:id="userCollectChart" title="Collects per User"
                      styleClass="animated-chart" prefWidth="600" prefHeight="400">
                <xAxis>
                    <CategoryAxis label="Users" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Number of Collects" />
                </yAxis>
            </BarChart>

            <VBox spacing="10" style="-fx-padding: 0 0 0 20;">
                <Label text="Filter Options" styleClass="filter-title"/>
                <ComboBox fx:id="userCollectSort" prefWidth="150" promptText="Sort by"/>
                <TextField fx:id="maxUsers" promptText="Max users to show" prefWidth="150"/>
                <Button text="Apply" onAction="#updateUserCollectChart" styleClass="chart-control"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>