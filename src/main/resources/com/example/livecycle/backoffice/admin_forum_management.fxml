<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.livecycle.controllers.backoffice.AdminForumController"
      spacing="20"
      style="-fx-padding: 25; -fx-background-color: #f8f9fa;"
      AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

    <!-- Header -->
    <HBox style="-fx-background-color: #343a40; -fx-background-radius: 10; -fx-padding: 15;">
        <Label text="Administration du Forum" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Filtres -->
    <HBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Filtrer par catégorie:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
        <ComboBox fx:id="cbCategories" prefWidth="300" style="-fx-background-radius: 5;"/>
        <Button text="Actualiser" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;">
            <graphic>
                <ImageView fitHeight="16" fitWidth="16">
                    <Image url="@../images/refresh.png"/>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

    <!-- Publications -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ImageView fitHeight="24" fitWidth="24">
                <Image url="@../images/post.png"/>
            </ImageView>
            <Label text="Publications" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
        </HBox>

        <TableView fx:id="postsTable" style="-fx-table-header-border-color: transparent;">
            <columns>
                <TableColumn prefWidth="200" text="Titre"/>
                <TableColumn prefWidth="350" text="Contenu"/>
                <TableColumn prefWidth="120" text="Date" style="-fx-alignment: CENTER;"/>
                <TableColumn prefWidth="150" text="Actions" fx:id="postActionCol" style="-fx-alignment: CENTER;">
                    <graphic>
                        <Label text="Actions" style="-fx-font-weight: bold;"/>
                    </graphic>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <style>
                .table-row-cell:filled {
                -fx-border-color: #f1f3f5;
                -fx-border-width: 0 0 1 0;
                }
                .table-row-cell:filled:selected {
                -fx-background-color: #e2f0fd;
                }
                .column-header {
                -fx-background-color: #6c757d;
                -fx-text-fill: white;
                -fx-font-weight: bold;
                }
            </style>
        </TableView>
    </VBox>

    <!-- Commentaires -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ImageView fitHeight="24" fitWidth="24">
                <Image url="@../images/comment.png"/>
            </ImageView>
            <Label text="Commentaires" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
        </HBox>

        <TableView fx:id="commentsTable" style="-fx-table-header-border-color: transparent;">
            <columns>
                <TableColumn prefWidth="450" text="Contenu"/>
                <TableColumn prefWidth="120" text="Date" style="-fx-alignment: CENTER;"/>
                <TableColumn prefWidth="150" text="Actions" fx:id="commentActionCol" style="-fx-alignment: CENTER;">
                    <graphic>
                        <Label text="Actions" style="-fx-font-weight: bold;"/>
                    </graphic>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <style>
                .table-row-cell:filled {
                -fx-border-color: #f1f3f5;
                -fx-border-width: 0 0 1 0;
                }
                .table-row-cell:filled:selected {
                -fx-background-color: #e2f0fd;
                }
                .column-header {
                -fx-background-color: #6c757d;
                -fx-text-fill: white;
                -fx-font-weight: bold;
                }
            </style>
        </TableView>
    </VBox>

</VBox>