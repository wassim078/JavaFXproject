<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.livecycle.controllers.backoffice.CategoryCollectManagement"
      stylesheets="@../css/collect_category.css"
      spacing="10" style="-fx-padding: 20;">

    <Text text="Collect Category Management" styleClass="header-text"/>

    <HBox spacing="10" styleClass="button-bar">
        <Button text="Add Category" onAction="#handleAddCategory" styleClass="success-button"/>
        <Button text="Edit Category" onAction="#handleEditCategory" styleClass="info-button"/>
        <Button text="Delete Category" onAction="#handleDeleteCategory" styleClass="danger-button"/>
    </HBox>

    <TableView fx:id="categoryTable" styleClass="category-table">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" styleClass="id-column"/>
            <TableColumn fx:id="nameColumn" text="Name" styleClass="name-column"/>
            <TableColumn fx:id="descColumn" text="Description" styleClass="desc-column"/>
        </columns>
    </TableView>
</VBox>