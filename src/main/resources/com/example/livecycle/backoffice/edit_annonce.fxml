<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.livecycle.controllers.backoffice.EditAnnonceController"
      spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5;">

    <Label text="Edit Announcement" 
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2e7d32; -fx-padding: 0 0 10 0;"/>

    <GridPane vgap="10" hgap="10">
        <Label text="Title:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="titleField" GridPane.rowIndex="0" GridPane.columnIndex="1" 
                  style="-fx-background-color: white; -fx-border-color: #2e7d32; -fx-border-radius: 5;"/>

        <Label text="Category:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="categoryCombo" GridPane.rowIndex="1" GridPane.columnIndex="1" 
                 style="-fx-background-color: white; -fx-border-color: #2e7d32; -fx-border-radius: 5;"/>

        <Label text="Weight (kg):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="weightField" GridPane.rowIndex="2" GridPane.columnIndex="1" 
                  style="-fx-background-color: white; -fx-border-color: #2e7d32; -fx-border-radius: 5;"/>

        <Label text="Price (TND):" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="priceField" GridPane.rowIndex="3" GridPane.columnIndex="1" 
                  style="-fx-background-color: white; -fx-border-color: #2e7d32; -fx-border-radius: 5;"/>

        <Label text="Quantity:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="quantityField" GridPane.rowIndex="4" GridPane.columnIndex="1" 
                  style="-fx-background-color: white; -fx-border-color: #2e7d32; -fx-border-radius: 5;"/>

        <Label text="Description:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="descriptionField" GridPane.rowIndex="5" GridPane.columnIndex="1" 
                 style="-fx-background-color: white; -fx-border-color: #2e7d32; -fx-border-radius: 5;"
                 wrapText="true"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <ImageView fx:id="imagePreview" fitWidth="150" fitHeight="150" 
                  style="-fx-border-color: #2e7d32; -fx-border-radius: 5;"/>
        <Button text="Browse Image" onAction="#handleImageBrowse"
                style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <Button text="Save Changes" onAction="#handleSave"
            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
</VBox>