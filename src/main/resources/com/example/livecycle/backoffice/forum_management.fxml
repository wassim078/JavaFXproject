<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="648.0" prefWidth="928.0" style="-fx-background-color: #f5f7fa; -fx-padding: 20;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.livecycle.controllers.backoffice.CategoryForumController">

    <!-- Header Section -->
    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 0 20 0;" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">
        <Label prefHeight="35.0" prefWidth="291.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Les catégories de Forum" />
        <HBox alignment="CENTER_RIGHT" spacing="10" HBox.hgrow="ALWAYS">
            <Button fx:id="btnPdf" onAction="#generatePdf" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@../images/pdf-icon.png" />
                    </ImageView>
                </graphic>
                <text>Générer PDF</text>
            </Button>
            <Button fx:id="btnQr" onAction="#generateQrCode" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@../images/qr.png" />
                    </ImageView>
                </graphic>
                <text>Générer QR Code</text>
            </Button>
        </HBox>
    </HBox>

    <!-- Form and Table Section -->
    <HBox spacing="30" style="-fx-padding: 0 0 20 0;" AnchorPane.bottomAnchor="80" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="80">
        <!-- Form Panel -->
        <VBox prefHeight="428.0" prefWidth="334.0" spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" text="Nouvelle Catégorie" />

            <Label style="-fx-font-weight: bold;" text="ID" />
            <TextField fx:id="ID" style="-fx-background-radius: 5;" />

            <Label style="-fx-font-weight: bold;" text="Nom" />
            <TextField fx:id="NAME" style="-fx-background-radius: 5;" />

            <Label style="-fx-font-weight: bold;" text="Description" />
            <TextField fx:id="DESCRIPTION" style="-fx-background-radius: 5;" />
        </VBox>

        <!-- Table Panel -->
        <VBox spacing="10" VBox.vgrow="ALWAYS">
            <TableView fx:id="table" onMouseClicked="#selectCategory" prefHeight="400.0" prefWidth="706.0" style="-fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <columns>
                    <TableColumn fx:id="Id" style="-fx-alignment: CENTER; -fx-font-weight: bold;" text="ID" />
                    <TableColumn fx:id="Name" style="-fx-font-weight: bold;" text="Nom" />
                    <TableColumn fx:id="Description" style="-fx-font-weight: bold;" text="Description" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <style>
                    -fx-table-header-border-color: transparent;
                    .table-row-cell:filled {
                    -fx-border-color: #f5f6fa;
                    -fx-border-width: 0 0 1 0;
                    }
                    .table-row-cell:filled:selected {
                    -fx-background-color: #e3f2fd;
                    }
                    .column-header {
                    -fx-background-color: #3498db;
                    -fx-text-fill: white;
                    }
                </style>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="statusLabel" style="-fx-text-fill: #7f8c8d;" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Button Bar -->
    <ButtonBar style="-fx-background-color: transparent; -fx-padding: 20;" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
        <buttons>
            <Button fx:id="btnSave" onAction="#createCategory" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 15;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@../images/save.png" />
                    </ImageView>
                </graphic>
                <text>Enregistrer</text>
            </Button>
            <Button fx:id="btnUpdate" onAction="#updateCategory" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 15;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@../images/edit.png" />
                    </ImageView>
                </graphic>
                <text>Modifier</text>
            </Button>
            <Button fx:id="btnDelete" onAction="#deleteCategory" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 15;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@../images/delete.png" />
                    </ImageView>
                </graphic>
                <text>Supprimer</text>
            </Button>
            <Button fx:id="btnClear" onAction="#clearCategory" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 15;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@../images/clear.png" />
                    </ImageView>
                </graphic>
                <text>Vider</text>
            </Button>
        </buttons>
    </ButtonBar>

</AnchorPane>
