<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Alert?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.livecycle.controllers.frontoffice.WhatsAppController">
    <TextField fx:id="phoneNumberField" promptText="Numéro de téléphone" />
    <TextField fx:id="messageField" promptText="Votre message" />
    <Button fx:id="sendButton" text="Envoyer" onAction="#sendMessage" />
</VBox>
