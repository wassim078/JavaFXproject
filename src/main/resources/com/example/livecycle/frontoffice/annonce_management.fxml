<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane stylesheets="@../css/shop_annonce.css"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.livecycle.controllers.frontoffice.AnnonceManagementController">

    <top>
        <VBox spacing="15" styleClass="header-section">
            <Text styleClass="shop-title" text="Announcement Shop 🛒" />
            
            <!-- Search and Filter Section -->
            <HBox spacing="15" alignment="CENTER">
                <TextField fx:id="searchField" promptText="Search announcements..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="categoryFilter" promptText="Category" styleClass="filter-combo" />
                <ComboBox fx:id="priceFilter" promptText="Price Range" styleClass="filter-combo" />
                <ComboBox fx:id="weightFilter" promptText="Weight Range" styleClass="filter-combo" />
                <Button fx:id="resetFilters" text="Reset" styleClass="reset-button" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            
            <ScrollPane fitToWidth="true" styleClass="modern-scroll-pane">
                <GridPane fx:id="annoncesGrid" 
                         alignment="CENTER" 
                         hgap="15" vgap="15" 
                         styleClass="announcements-grid"/>
            </ScrollPane>
            
            <Pagination fx:id="pagination" 
                       styleClass="modern-pagination"
                       maxPageIndicatorCount="5"/>
        </VBox>
    </center>

    <StackPane fx:id="rootStackPane" visible="false" managed="false"/>
</BorderPane>