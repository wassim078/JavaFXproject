<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.livecycle.controllers.frontoffice.ChatBotController"
      spacing="10"
      style="-fx-padding: 20; -fx-background-color: #F0F8FF;">

    <ScrollPane fitToWidth="true" fitToHeight="true">
        <TextArea fx:id="chatArea" editable="false" wrapText="true"
                  style="-fx-font-family: 'Arial'; -fx-font-size: 14px;"/>
    </ScrollPane>

    <!-- Ajoutez cette partie manquante -->
    <HBox spacing="10">
        <TextField fx:id="userInput" promptText="Tapez votre message..."
                   style="-fx-font-size: 14px; -fx-pref-width: 400px;"
                   onAction="#handleUserInput"/>
        <Button text="Send"
                style="-fx-font-size: 14px; -fx-background-color: #4682B4; -fx-text-fill: white;"
                onAction="#handleUserInput"/>
    </HBox>

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
</VBox>