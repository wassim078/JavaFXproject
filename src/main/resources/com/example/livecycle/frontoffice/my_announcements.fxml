<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<BorderPane fx:id="root" stylesheets="@../css/annonce.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.livecycle.controllers.frontoffice.MyAnnouncementsController">
    <top>
        <VBox spacing="10">
            <HBox fx:id="topSection" alignment="CENTER" spacing="20" style="-fx-padding: 20 0 30 0; -fx-background-color: #ffffff;">
                <Button fx:id="createBtn" onAction="#handleCreateAnnonce" styleClass="create-btn" text="＋ Create New Announcement" />
                <Button fx:id="notificationBtn" onAction="#showNotificationHistory" styleClass="notification-btn">
                    <graphic>
                        <Label text="🔔" style="-fx-font-size: 20px;" />
                    </graphic>
                </Button>
            </HBox>
            <VBox fx:id="notificationsBox" style="-fx-padding: 0 20;" />
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="mainScrollPane" fitToWidth="true" prefHeight="36.0" style="-fx-background: #F5F5F5;">
            <GridPane fx:id="annoncesGrid" hgap="20" style="-fx-padding: 20; -fx-max-width: 1200px;" vgap="20">
                <columnConstraints>
                    <ColumnConstraints halignment="CENTER" percentWidth="33.3" />
                    <ColumnConstraints halignment="CENTER" percentWidth="33.3" />
                    <ColumnConstraints halignment="CENTER" percentWidth="33.3" />
                </columnConstraints>
            </GridPane>
            <BorderPane.margin>
                <Insets left="150.0" />
            </BorderPane.margin>
        </ScrollPane>
    </center>
</BorderPane>
